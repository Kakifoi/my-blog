---
import { SITE_TITLE } from '../consts';

const instagramUrl = 'https://www.instagram.com/kakifoi_blog/';
const navLinks = [
	{ href: '/about/', label: 'プロフィール' },
	{ href: '/', label: 'ホーム' },
	{ href: '/contact/', label: 'お問い合わせ' },
	{ href: '/tags/', label: 'タグ一覧' },
	{ href: '/categories/', label: 'カテゴリ一覧' },
	{ href: '/privacy/', label: 'プライバシー＆免責事項' },
];
---

<header class="home-header">
	<div class="masthead">
		<button class="mobile-menu-toggle" type="button" aria-label="メニューを開く" aria-controls="home-navigation" aria-expanded="false"><span></span><span></span><span></span></button>
		<a class="brand" href="/" aria-label={`${SITE_TITLE} ホーム`}>
			<img class="brand-illustration brand-illustration-left" src="/images/home-header-travel-food-v2.jpg" data-display-image="header-left" alt="" width="1200" height="900" loading="eager" decoding="async" />
			<span class="brand-copy">
				<span class="brand-title">{SITE_TITLE}</span>
				<span class="brand-tagline">熊谷・深谷の食べ歩きと、<br class="brand-tagline-break" />家族で出かけた日の記録。</span>
			</span>
			<img class="brand-illustration brand-illustration-right" src="/images/home-header-sisters-cat-v2.jpg" data-display-image="header-right" alt="" width="1200" height="900" loading="eager" decoding="async" />
		</a>
		<div class="header-social" aria-label="SNSとサイト内メニュー">
			<a href="https://x.com/amekagari" target="_blank" rel="noopener noreferrer" aria-label="X">𝕏</a>
			<a class="header-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram（新しいタブで開きます）"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
			<a href="/contact/" aria-label="お問い合わせ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg></a>
			<a href="/search/" aria-label="サイト内検索"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></a>
		</div>
		<a class="mobile-search" href="/search/" aria-label="サイト内検索"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></a>
	</div>
	<nav id="home-navigation" class="home-navigation" aria-label="メインメニュー">
		<div class="navigation-inner">{navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}</div>
	</nav>
</header>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
	const navigation = document.getElementById('home-navigation');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') !== 'true';
		menuToggle.setAttribute('aria-expanded', String(expanded));
		menuToggle.setAttribute('aria-label', expanded ? 'メニューを閉じる' : 'メニューを開く');
		navigation?.classList.toggle('is-open', expanded);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
		menuToggle.setAttribute('aria-expanded', 'false');
		menuToggle.setAttribute('aria-label', 'メニューを開く');
		navigation?.classList.remove('is-open');
		menuToggle.focus();
	});
</script>

<style>
	.home-header { position: relative; }
	.masthead { position: relative; display: flex; align-items: center; justify-content: center; min-height: 150px; padding: 0 164px; overflow: hidden; border-top: 2px solid #CC0000; background: #fffaf5; }
	.brand { position: relative; display: flex; align-items: center; justify-content: center; width: min(100%, 900px); height: 148px; min-width: 0; text-align: center; isolation: isolate; }
	.brand-copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
	:global(.home-reference .brand), :global(.home-reference .brand:hover) { color: #CC0000; }
	.brand-title { font-family: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif; font-size: 40px; font-weight: 800; letter-spacing: 0.06em; line-height: 1.3; white-space: nowrap; }
	.brand-tagline { color: #78635b; font-size: 11px; font-weight: 400; letter-spacing: 0.04em; line-height: 1.7; }
	.brand-tagline-break { display: none; }
	.brand-illustration { position: absolute; display: block; height: auto; aspect-ratio: 4 / 3; object-fit: contain; border-radius: 0; mix-blend-mode: multiply; pointer-events: none; }
	.brand-illustration-left { right: calc(50% + 148px); bottom: -24px; width: 260px; }
	.brand-illustration-right { left: calc(50% + 148px); bottom: -3px; width: 210px; }
	.header-social { position: absolute; right: max(24px, calc((100% - 1140px) / 2)); top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 8px; color: #CC0000; }
	.header-social a, .header-instagram { display: flex; align-items: center; justify-content: center; width: 28px; height: 32px; font-size: 22px; }
	:global(.home-reference .header-social a:hover), :global(.home-reference .mobile-search:hover) { color: #aa0000; }
	:global(.home-reference .masthead :focus-visible) { outline-color: #CC0000; }
	:global(.home-reference .brand:focus-visible) { outline-offset: -6px; }
	svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.home-navigation { background: #CC0000; }
	.navigation-inner { max-width: 1140px; min-height: 44px; margin: 0 auto; display: flex; align-items: stretch; justify-content: space-around; }
	:global(.home-reference .navigation-inner a) { display: flex; align-items: center; justify-content: center; padding: 8px 18px; color: #fff; font-size: 14px; line-height: 2; }
	:global(.home-reference .navigation-inner a:hover) { background: #b00000; color: #fff; }
	:global(.home-reference .home-navigation :focus-visible) { outline-color: #fff; outline-offset: -5px; }
	.mobile-menu-toggle, .mobile-search { display: none; }
	@media (min-width: 768px) and (max-width: 1199px) {
		.masthead { padding: 32px 24px 0; }
		.header-social { top: 8px; right: 20px; transform: none; }
		.brand { height: 138px; }
		.brand-title { font-size: clamp(28px, 3.4vw, 38px); letter-spacing: 0.04em; }
		.brand-illustration-left { right: calc(50% + 140px); bottom: -20px; width: 220px; }
		.brand-illustration-right { left: calc(50% + 140px); bottom: -6px; width: 200px; }
		:global(.home-reference .navigation-inner a) { padding-inline: 12px; font-size: 13px; }
	}
	@media (max-width: 767px) {
		.masthead { min-height: 150px; padding: 0 48px; }
		.brand { width: min(100%, 480px); height: 148px; }
		.brand-copy { align-self: flex-start; padding-top: 20px; gap: 8px; }
		.brand-title { font-size: clamp(20px, 6vw, 26px); letter-spacing: 0; }
		.brand-tagline { max-width: 140px; font-size: 10px; letter-spacing: 0; line-height: 1.55; }
		.brand-tagline-break { display: initial; }
		.brand-illustration-left { right: auto; left: -42px; bottom: -12px; width: 110px; }
		.brand-illustration-right { left: auto; right: -42px; bottom: 0; width: 110px; }
		.header-social { display: none; }
		.mobile-menu-toggle { display: flex; position: absolute; left: 4px; top: 14px; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; padding: 0; background: none; flex-direction: column; gap: 4px; cursor: pointer; }
		.mobile-menu-toggle span { display: block; height: 2px; width: 18px; background: #CC0000; }
		.mobile-search { display: flex; position: absolute; right: 4px; top: 14px; align-items: center; justify-content: center; width: 44px; height: 44px; color: #CC0000; }
		.home-navigation { display: none; }
		.home-navigation.is-open { display: block; }
		.navigation-inner { display: grid; grid-template-columns: 1fr 1fr; padding: 8px; }
		:global(.home-reference .navigation-inner a) { font-size: 12px; padding: 9px 6px; }
	}
	@media (max-width: 359px) {
		.brand-tagline { max-width: 120px; font-size: 9px; }
		.brand-illustration-left, .brand-illustration-right { width: 96px; }
	}
</style>
