---
import BlogmuraRanking from './BlogmuraRanking.astro';
import { SITE_TITLE } from '../consts';

const today = new Date();
const categories = ['グルメ', '旅行・おでかけ', '子育て・日常', 'ゲーム・エンタメ', 'ガジェット・テクノロジー', 'お金・投資', '健康・ランニング'];
---

<footer class="site-footer" data-pagefind-ignore>
	<div class="footer-widgets">
		<section class="footer-about" aria-label="このブログについて">
			<a href="/" class="footer-brand">{SITE_TITLE}</a>
			<p>熊谷・深谷の食べ歩きと、家族で出かけた日の記録。</p>
			<p>ブログの感想やご連絡は、<a href="/contact/">お問い合わせ</a>からお願いします。</p>
			<p>当サイトはアフィリエイト広告を利用しています。</p>
			<h2>このブログについて</h2>
			<ul>
				<li><a href="/about/">プロフィール</a></li>
				<li><a href="/blog/why-i-started-blog/">ブログを始めた理由</a></li>
				<li><a href="/contact/">お問い合わせ</a></li>
			</ul>
		</section>
		<section aria-labelledby="footer-categories-title">
			<h2 id="footer-categories-title">カテゴリー</h2>
			<ul>{categories.map((category) => <li><a href={`/categories/${category}/`}>› {category}</a></li>)}</ul>
		</section>
		<BlogmuraRanking />
	</div>
	<div class="footer-bottom">
		<nav class="footer-links" aria-label="サイト情報">
			<a href="/privacy/">プライバシー＆免責事項</a>
			<a href="/rss.xml">RSS</a>
		</nav>
		<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer { background: #fff1f1; color: #333; margin-top: 3em; }
	.footer-widgets { box-sizing: border-box; max-width: 1200px; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.9fr) minmax(280px, 350px); gap: 45px; margin: 0 auto; padding: 60px 30px; font-size: 13px; line-height: 1.8; }
	.footer-widgets > section { min-width: 0; }
	.site-footer a { color: inherit; text-decoration: none; }
	.site-footer a:hover { color: #aa0000; text-decoration: underline; }
	.site-footer a:focus-visible { outline: 3px solid #aa0000; outline-offset: 4px; }
	.footer-brand { display: block; font-size: 25px; font-weight: 700; letter-spacing: 0.02em; margin-bottom: 20px; }
	h2 { font-size: 18px; font-weight: 400; line-height: 1.6; border-bottom: 1px solid #ddb7b7; padding-bottom: 12px; margin: 0 0 20px; }
	.footer-about h2 { margin-top: 28px; }
	.footer-widgets ul { list-style: none; padding: 0; margin: 0; }
	.footer-widgets li { margin: 8px 0; }
	.footer-about p { margin: 0 0 16px; }
	.footer-about p a { text-decoration: underline; }
	.footer-bottom { background: #CC0000; padding: 24px 20px; text-align: center; }
	.footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25em 1.5em; margin-bottom: 12px; }
	.footer-links a { color: #ffffffe0; font-size: 12px; }
	.footer-links a:hover { color: #fff; }
	.footer-bottom a:focus-visible { outline-color: #fff; }
	.copyright { font-size: 11px; line-height: 1.8; color: #ffffffbf; margin: 0; }
	@media (max-width: 900px) {
		.footer-widgets { grid-template-columns: minmax(0, 1fr); gap: 30px; padding: 35px 24px; }
		.footer-brand { font-size: 25px; }
	}
</style>
