---
import type { CollectionEntry } from 'astro:content';
import { tagSlug } from '../utils/tagSlug';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const categories = ['グルメ', '旅行・おでかけ', '子育て・日常', 'ゲーム・エンタメ', 'ガジェット・テクノロジー', 'お金・投資', '健康・ランニング'];
const tagCounts = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1]).slice(0, 28);
const latestPosts = posts.slice(0, 5);
const instagramUrl = 'https://www.instagram.com/kakifoi_blog/';
const dateText = (date: Date) => new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo' }).format(date);
---

<aside class="home-sidebar" aria-label="プロフィールと記事を探す">
	<section class="sponsor-guide" aria-labelledby="sponsor-title"><h2 class="widget-title" id="sponsor-title">Sponsored Link</h2><a href="/#recommended-products" class="home-products-cta">使って・食べてよかったものを見る →</a></section>
	<section class="profile-widget" aria-labelledby="profile-name">
		<a href="/about/" class="profile-avatar"><img src="/images/profile.png" data-display-image="avatar" alt="カキフォイ" width="110" height="110" loading="lazy" decoding="async" /></a>
		<h2 id="profile-name">カキフォイ</h2>
		<p class="profile-subtitle">埼玉在住、2児の父</p>
		<div class="profile-copy"><p class="profile-opening">／<br />家族との日常を、写真と本音で。<br />＼</p><p>妻と子供2人の4人家族。<br />育児・家事と仕事をこなしながら、等身大の日常をつづっています。</p><p>このブログでは、</p><ul><li>熊谷・深谷の食べ歩き</li><li>子供とのおでかけ・家族旅行</li><li>買って使ったものの感想</li><li>ゲームやジョギングの記録</li></ul><p>などを紹介しています。</p><p>詳しい自己紹介はこちらから。</p></div>
		<a class="profile-button" href="/about/">プロフィール</a>
		<p class="follow-label">＼ Follow me ／</p>
		<div class="profile-social"><a href="https://x.com/amekagari" target="_blank" rel="noopener noreferrer" aria-label="カキフォイのX">𝕏</a><a class="profile-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="カキフォイのInstagram（新しいタブで開きます）"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a><a href="/contact/" aria-label="お問い合わせ">✉</a><a href="/rss.xml" aria-label="RSS">RSS</a></div>
	</section>
	<a class="sidebar-banner" href="/#recommended-products"><span>使って・食べてよかったもの</span><small>グリルとお肉の感想・購入先を見る</small><span aria-hidden="true">›</span></a>
	<section class="sidebar-widget"><h2 class="widget-title">ブログ内検索</h2><a class="search-entry" href="/search/"><span>キーワードから記事を探す</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></a></section>
	<section class="sidebar-widget"><h2 class="widget-title">カテゴリー</h2><ul class="category-list">{categories.map((category) => <li><a href={`/categories/${category}/`}><span>› {category}</span><span class="category-count">{posts.filter((post) => post.data.category === category).length}</span></a></li>)}</ul></section>
	<section class="sidebar-widget"><h2 class="widget-title">タグ</h2><div class="sidebar-tags">{tags.map(([tag, count]) => <a href={`/tags/${tagSlug(tag)}/`} title={`${tag}の記事 ${count}件`}><span aria-hidden="true">♧ </span>{tag}</a>)}</div><a class="all-tags" href="/tags/">すべてのタグを見る ›</a></section>
	<section class="sidebar-widget"><h2 class="widget-title">最近の投稿</h2><ul class="recent-posts">{latestPosts.map((post) => <li><a href={`/blog/${post.id}/`}><span aria-hidden="true">›</span>{post.data.title}<time datetime={post.data.pubDate.toISOString()}>{dateText(post.data.pubDate)}</time></a></li>)}</ul></section>
</aside>

<style>
	svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.home-sidebar { min-width: 0; }
	.widget-title { position: relative; font-size: 25px; line-height: 1.4; letter-spacing: 0.07em; font-weight: 400; padding: 0 0 10px; margin: 0 0 25px; }
	.widget-title::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; background: repeating-linear-gradient(135deg, #CC0000 0, #CC0000 2px, #fff 2px, #fff 4px); }
	.sponsor-guide .widget-title { margin: 0; }
	.sponsor-guide .home-products-cta { display: block; margin: 12px 0 22px; text-align: center; color: #8c8a84; font-size: 11px; text-underline-offset: 3px; }
	.profile-widget { border: 1px solid #eee; box-shadow: 0 0 2px #00000008; padding: 35px 25px 24px; margin: 0 0 34px; text-align: center; }
	.profile-avatar { display: inline-block; }
	.profile-avatar img { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; }
	.profile-widget h2 { font-size: 20px; font-weight: 500; margin: 8px 0 0; }
	.profile-subtitle { font-size: 12px; color: #aaa; margin: 0 0 18px; }
	.profile-copy { font-size: 16px; line-height: 1.65; text-align: left; }
	.profile-copy p { margin: 0 0 18px; }
	.profile-opening { line-height: 1.6; }
	.profile-copy ul { list-style: none; margin: 0 0 18px; padding: 0; }
	.profile-copy li::before { content: '✮ '; color: #CC0000; }
	.profile-button { display: block; width: 170px; border: 1px solid #CC0000; border-radius: 2px; margin: 18px auto 22px; padding: 7px; font-size: 14px; }
	.follow-label { margin: 0 0 5px; font-size: 12px; }
	.profile-social { display: flex; justify-content: center; align-items: center; gap: 18px; color: #CC0000; }
	.profile-social a { font-size: 23px; }
	.profile-instagram { display: flex; align-items: center; justify-content: center; }
	.profile-social a:last-child { font-size: 12px; }
	.sidebar-banner { display: block; position: relative; padding: 25px 25px 26px; text-align: center; background: #CC0000; margin: 0 0 35px; border: 6px solid #fff1f1; outline: 1px solid #efcccc; box-shadow: 0 2px 5px #0001; }
	:global(.home-reference .sidebar-banner), :global(.home-reference .sidebar-banner:hover) { color: #fff; }
	.sidebar-banner > span:first-child { display: block; font-size: 17px; font-weight: 700; }
	.sidebar-banner small { font-size: 11px; }
	.sidebar-banner > span:last-child { position: absolute; right: 9px; top: 25%; font-size: 36px; }
	.sidebar-widget { margin: 0 0 40px; }
	.search-entry { display: flex; justify-content: space-between; gap: 5px; align-items: center; padding: 12px; border: 1px solid #ddd; color: #888; font-size: 12px; }
	.category-list, .recent-posts { padding: 0; list-style: none; margin: 0; }
	.category-list a { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 0; border-bottom: 1px solid #eee; font-size: 14px; }
	.category-count { color: #aaa; font-size: 11px; }
	.sidebar-tags { display: flex; gap: 7px 5px; flex-wrap: wrap; }
	.sidebar-tags a { background: #f4f4f4; border-radius: 2px; padding: 3px 7px; font-size: 11px; }
	.sidebar-tags a:hover { background: #fff1f1; }
	.all-tags { display: block; text-align: right; margin-top: 15px; font-size: 12px; }
	.recent-posts a { display: block; position: relative; font-size: 14px; padding: 12px 0 12px 14px; border-bottom: 1px solid #eee; line-height: 1.7; }
	.recent-posts a > span { position: absolute; left: 0; }
	.recent-posts time { display: block; font-size: 10px; color: #999; margin-top: 4px; text-align: right; }
	@media (min-width: 768px) and (max-width: 1199px) {
		.profile-widget { padding: 30px 18px 20px; }
	}
	@media (max-width: 767px) {
		.home-sidebar { margin: 55px 6px 0; }
		.sponsor-guide { margin-bottom: 25px; }
		.sponsor-guide .home-products-cta { margin-bottom: 0; }
		.widget-title { font-size: 22px; }
		.profile-widget { padding: 30px 25px; }
		.profile-copy { font-size: 14px; line-height: 1.9; }
	}
</style>
