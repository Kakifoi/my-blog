---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { tagSlug } from '../utils/tagSlug';

interface Props {
	category: string;
	posts: CollectionEntry<'blog'>[];
}

const { category, posts } = Astro.props;
const healthCategories = ['健康', '医療', '美容'];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${category} | ${SITE_TITLE}`} description={`「${category}」カテゴリの記事一覧`} />
	</head>
	<body>
		<Header />
		<main>
			<a href="/categories" class="back-link">← カテゴリ一覧へ戻る</a>
			<h1 class="section-heading">{category}（{posts.length}件）</h1>
			{healthCategories.includes(category) && (
				<nav class="related-categories" aria-label="健康・医療・美容のカテゴリ">
					{healthCategories.map((relatedCategory) => (
						<a href={`/categories/${relatedCategory}/`} aria-current={relatedCategory === category ? 'page' : undefined}>{relatedCategory}</a>
					))}
				</nav>
			)}

			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-card">
						<div class="post-meta">
							<span class="cat-badge">{category}</span>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</div>
						<h2 class="post-title">
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</h2>
						<p class="post-desc">{post.data.description}</p>
						{post.data.tags && post.data.tags.length > 0 && (
							<div class="tag-row">
								{post.data.tags.map((tag) => (
									<a href={`/tags/${tagSlug(tag)}/`} class="tag-pill">{tag}</a>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
.back-link { font-size: 0.85rem; color: #CC0000; display: inline-block; margin-bottom: 0.75em; }
.back-link:hover { text-decoration: underline; }

.related-categories { display: flex; flex-wrap: wrap; gap: 0.5em; margin: 0 0 1.5em; font-size: 0.85rem; }
.related-categories a { border: 1px solid #e8d6d3; border-radius: 4px; padding: 0.35em 0.9em; color: #87372c; text-decoration: none; }
.related-categories a:hover { background: #fff1ee; }
.related-categories a[aria-current="page"] { background: #CC0000; border-color: #CC0000; color: #fff; }
.related-categories a:focus-visible { outline: 3px solid #87372c; outline-offset: 3px; }

.post-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75em; }

.post-card {
	background: #fff;
	border: 1px solid #e8e8e8;
	border-radius: 6px;
	padding: 1.1em 1.4em;
	box-shadow: 0 1px 4px rgba(0,0,0,0.05);
	transition: box-shadow 0.2s;
}
.post-card:hover { box-shadow: 0 3px 10px rgba(0,0,0,0.09); }

.post-meta { display: flex; align-items: center; gap: 0.6em; margin-bottom: 0.4em; }
.post-date { font-size: 0.8rem; color: #999; }
.post-title { font-size: 1rem; font-weight: 700; margin: 0 0 0.4em; line-height: 1.5; }
.post-title a { color: #222; text-decoration: none; }
.post-title a:hover { color: #CC0000; text-decoration: none; }
.post-desc { font-size: 0.85rem; color: #666; margin: 0 0 0.5em; line-height: 1.65; }
.tag-row { display: flex; flex-wrap: wrap; gap: 0.4em; }
</style>
