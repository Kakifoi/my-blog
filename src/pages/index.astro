---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import HomePostGrid from '../components/HomePostGrid.astro';
import HomeRecommendations from '../components/HomeRecommendations.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { tagSlug } from '../utils/tagSlug';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pickupPosts = posts.filter((post) => post.data.heroImage).slice(0, 8);
const categories = ['グルメ', '旅行・おでかけ', '子育て・日常', 'ゲーム・エンタメ', 'ガジェット・テクノロジー', 'お金・投資', '健康・ランニング'];
const tagCounts = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1]).slice(0, 28);
const latestPosts = posts.slice(0, 5);
const dateText = (date: Date) => new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo' }).format(date);
const navLinks = [
	{ href: '/about/', label: 'プロフィール' },
	{ href: '/', label: 'ホーム' },
	{ href: '/contact/', label: 'お問い合わせ' },
	{ href: '/tags/', label: 'タグ一覧' },
	{ href: '/categories/', label: 'カテゴリ一覧' },
	{ href: '/privacy/', label: 'プライバシー＆免責事項' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} ogImage="https://kakifoi.net/images/og-default.jpg" />
	</head>
	<body class="home-reference">
		<a class="skip-link" href="#home-content">記事一覧へ移動</a>
		<header class="home-header">
			<div class="masthead">
				<button class="mobile-menu-toggle" type="button" aria-label="メニューを開く" aria-controls="home-navigation" aria-expanded="false"><span></span><span></span><span></span></button>
				<a class="brand" href="/" aria-label={`${SITE_TITLE} ホーム`}>
					<span class="brand-title">{SITE_TITLE}</span>
					<span class="brand-tagline">熊谷・深谷の食べ歩きと、家族で出かけた日の記録。</span>
				</a>
				<div class="header-social" aria-label="SNSとサイト内メニュー">
					<a href="https://x.com/amekagari" target="_blank" rel="noopener noreferrer" aria-label="X">𝕏</a>
					<span class="header-instagram" title="Instagramのリンクは後日設定"><svg viewBox="0 0 24 24" role="img" aria-label="Instagram（リンク未設定）"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></span>
					<a href="/contact/" aria-label="お問い合わせ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg></a>
					<a href="/search/" aria-label="サイト内検索"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></a>
				</div>
				<a class="mobile-search" href="/search/" aria-label="サイト内検索"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></a>
			</div>
			<nav id="home-navigation" class="home-navigation" aria-label="メインメニュー">
				<div class="navigation-inner">{navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}</div>
			</nav>
		</header>

		<section class="pickup" aria-label="ピックアップ記事" aria-roledescription="カルーセル">
			<div class="pickup-window">
				<ul class="pickup-track" id="pickup-track">
					{pickupPosts.map((post, index) => (
						<li class="pickup-item">
							<a href={`/blog/${post.id}/`}>
								<div class="pickup-image"><img src={post.data.heroImage} alt="" width="1200" height="675" data-list-thumbnail loading={index < 5 ? 'eager' : 'lazy'} decoding="async" /><span class="category-label">{post.data.category}</span></div>
								<p>{post.data.title}</p>
							</a>
						</li>
					))}
				</ul>
				<button class="pickup-arrow previous" type="button" aria-label="前のピックアップ記事" aria-controls="pickup-track">‹</button>
				<button class="pickup-arrow next" type="button" aria-label="次のピックアップ記事" aria-controls="pickup-track">›</button>
			</div>
			<div class="pickup-controls">
				<div class="pickup-dots" aria-label="ピックアップ記事の表示位置">{pickupPosts.map((_, index) => <button type="button" class:list={['pickup-dot', { active: index === 0 }]} aria-label={`${index + 1}番目のピックアップ記事を表示`} aria-pressed={index === 0 ? 'true' : 'false'} data-slide={index}></button>)}</div>
				<button class="pickup-playback" type="button" aria-label="ピックアップの自動送りを停止" aria-pressed="false">Ⅱ</button>
			</div>
		</section>

		<div class="home-shell">
			<main id="home-content" class="home-main">
				<div class="home-intro">
					<h1>{SITE_TITLE}｜熊谷・深谷のグルメと家族の日常ブログ</h1>
					<p>埼玉在住、2児の父・カキフォイが、行った場所や使ったものを写真と本音でつづります。ゲームや買い物、日々の出来事も。</p>
				</div>
				<HomePostGrid posts={posts} />
				<div class="category-features">
					<section class="category-feature">
						<h2>子育て・日常の最新記事</h2>
						<a href="/categories/子育て・日常/" class="feature-banner"><img src={posts.find((post) => post.data.category === '子育て・日常' && post.data.heroImage)?.data.heroImage} alt="" width="1200" height="675" loading="lazy" decoding="async" /><span>子育て・日常<span class="feature-small">家族と過ごす日々の記録</span><span class="feature-arrow">›</span></span></a>
					</section>
					<section class="category-feature">
						<h2>旅行・おでかけの最新記事</h2>
						<a href="/categories/旅行・おでかけ/" class="feature-banner"><img src={posts.find((post) => post.data.category === '旅行・おでかけ' && post.data.heroImage)?.data.heroImage} alt="" width="1200" height="675" loading="lazy" decoding="async" /><span>旅行・おでかけ<span class="feature-small">家族で出かけた日の記録</span><span class="feature-arrow">›</span></span></a>
					</section>
				</div>
				<HomeRecommendations />
			</main>

			<aside class="home-sidebar" aria-label="プロフィールと記事を探す">
				<section class="sponsor-guide" aria-labelledby="sponsor-title"><h2 class="widget-title" id="sponsor-title">Sponsored Link</h2><a href="/#recommended-products" class="home-products-cta">使って・食べてよかったものを見る →</a></section>
				<section class="profile-widget" aria-labelledby="profile-name">
					<a href="/about/" class="profile-avatar"><img src="/images/profile.png" alt="カキフォイ" width="110" height="110" loading="lazy" decoding="async" /></a>
					<h2 id="profile-name">カキフォイ</h2>
					<p class="profile-subtitle">埼玉在住、2児の父</p>
					<div class="profile-copy"><p class="profile-opening">／<br />家族との日常を、写真と本音で。<br />＼</p><p>妻と子供2人の4人家族。<br />育児・家事と仕事をこなしながら、等身大の日常をつづっています。</p><p>このブログでは、</p><ul><li>熊谷・深谷の食べ歩き</li><li>子供とのおでかけ・家族旅行</li><li>買って使ったものの感想</li><li>ゲームやジョギングの記録</li></ul><p>などを紹介しています。</p><p>詳しい自己紹介はこちらから。</p></div>
					<a class="profile-button" href="/about/">プロフィール</a>
					<p class="follow-label">＼ Follow me ／</p>
					<div class="profile-social"><a href="https://x.com/amekagari" target="_blank" rel="noopener noreferrer" aria-label="カキフォイのX">𝕏</a><a href="/contact/" aria-label="お問い合わせ">✉</a><a href="/rss.xml" aria-label="RSS">RSS</a></div>
				</section>
				<a class="sidebar-banner" href="/#recommended-products"><span>使って・食べてよかったもの</span><small>グリルとお肉の感想・購入先を見る</small><span aria-hidden="true">›</span></a>
				<section class="sidebar-widget"><h2 class="widget-title">ブログ内検索</h2><a class="search-entry" href="/search/"><span>キーワードから記事を探す</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></a></section>
				<section class="sidebar-widget"><h2 class="widget-title">カテゴリー</h2><ul class="category-list">{categories.map((category) => <li><a href={`/categories/${category}/`}><span>› {category}</span><span class="category-count">{posts.filter((post) => post.data.category === category).length}</span></a></li>)}</ul></section>
				<section class="sidebar-widget"><h2 class="widget-title">タグ</h2><div class="sidebar-tags">{tags.map(([tag, count]) => <a href={`/tags/${tagSlug(tag)}/`} title={`${tag}の記事 ${count}件`}><span aria-hidden="true">♧ </span>{tag}</a>)}</div><a class="all-tags" href="/tags/">すべてのタグを見る ›</a></section>
				<section class="sidebar-widget"><h2 class="widget-title">最近の投稿</h2><ul class="recent-posts">{latestPosts.map((post) => <li><a href={`/blog/${post.id}/`}><span aria-hidden="true">›</span>{post.data.title}<time datetime={post.data.pubDate.toISOString()}>{dateText(post.data.pubDate)}</time></a></li>)}</ul></section>
			</aside>
		</div>

		<footer class="home-footer">
			<div class="footer-widgets"><section class="footer-about"><a href="/" class="footer-brand">{SITE_TITLE}</a><p>熊谷・深谷の食べ歩きと、家族で出かけた日の記録。</p><p>ブログの感想やご連絡は、<a href="/contact/">お問い合わせ</a>からお願いします。</p><p>当サイトはアフィリエイト広告を利用しています。</p></section><section><h2>カテゴリー</h2><ul>{categories.map((category) => <li><a href={`/categories/${category}/`}>› {category}</a></li>)}</ul></section><section><h2>このブログについて</h2><ul><li><a href="/about/">プロフィール</a></li><li><a href="/blog/why-i-started-blog/">ブログを始めた理由</a></li><li><a href="/contact/">お問い合わせ</a></li><li><a href="/privacy/">プライバシー＆免責事項</a></li><li><a href="/rss.xml">RSS</a></li></ul></section></div>
			<p class="home-copyright">© {new Date().getFullYear()} {SITE_TITLE}</p>
		</footer>
		<a class="back-to-top" href="#" aria-label="ページの先頭へ戻る">⌃</a>
		<script src="../scripts/homepage.ts"></script>
	</body>
</html>

<style>
	:global(body.home-reference) { --home-accent: #CC0000; --home-ink: #333; background: #fff; color: var(--home-ink); font-family: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.8; }
	:global(.home-reference a) { color: inherit; }
	:global(.home-reference a:hover) { color: #aa0000; text-decoration: none; }
	:global(.home-reference .btn-amazon), :global(.home-reference .btn-amazon:hover) { color: #111; }
	:global(.home-reference .btn-rakuten), :global(.home-reference .btn-yahoo), :global(.home-reference .btn-rakuten:hover), :global(.home-reference .btn-yahoo:hover) { color: #fff; }
	:global(.home-reference :focus-visible) { outline: 3px solid #aa0000; outline-offset: 4px; }
	:global(.home-reference [hidden]) { display: none !important; }
	.skip-link { position: fixed; top: -60px; left: 10px; z-index: 200; padding: 10px 18px; background: #fff; }
	.skip-link:focus { top: 10px; }
	.home-header { position: relative; }
	.masthead { position: relative; display: flex; align-items: center; justify-content: center; min-height: 140px; padding: 24px 150px; background: #CC0000; }
	.brand { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
	:global(.home-reference .brand), :global(.home-reference .brand:hover) { color: #fff; }
	.brand-title { font-family: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif; font-size: 40px; font-weight: 800; letter-spacing: 0.09em; line-height: 1.3; white-space: nowrap; }
	.brand-tagline { color: #ffffffd9; font-size: 11px; font-weight: 400; letter-spacing: 0.08em; line-height: 1.6; }
	.header-social { position: absolute; right: max(30px, calc((100% - 1140px) / 2)); top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 13px; color: #fff; }
	.header-social a, .header-instagram { display: flex; align-items: center; justify-content: center; width: 18px; height: 23px; font-size: 22px; }
	:global(.home-reference .header-social a:hover), :global(.home-reference .mobile-search:hover) { color: #fff; opacity: 0.75; }
	:global(.home-reference .masthead :focus-visible) { outline-color: #fff; }
	svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.home-navigation { background: #fff; border-bottom: 1px solid #e0e0e0; box-shadow: 0 1px 4px #0000000d; }
	.navigation-inner { max-width: 1140px; min-height: 46px; margin: 0 auto; display: flex; align-items: stretch; justify-content: space-around; }
	:global(.home-reference .navigation-inner a) { display: flex; align-items: center; justify-content: center; padding: 9px 18px; color: #444; font-size: 14px; line-height: 2; }
	:global(.home-reference .navigation-inner a:hover) { background: #fff3f3; color: #CC0000; }
	.mobile-menu-toggle, .mobile-search { display: none; }
	.pickup { max-width: 1140px; margin: 30px auto 20px; min-height: 210px; }
	.pickup-window { position: relative; }
	.pickup-track { display: flex; gap: 16px; list-style: none; margin: 0; padding: 0; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; }
	.pickup-track::-webkit-scrollbar { display: none; }
	.pickup-item { flex: 0 0 calc((100% - 64px) / 5); min-width: 0; scroll-snap-align: start; }
	.pickup-item a { display: block; }
	.pickup-image { position: relative; aspect-ratio: 16 / 9; }
	.pickup-image img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 2px; box-shadow: 0 1px 3px #0003; }
	.category-label { position: absolute; top: 7px; left: 7px; padding: 1px 9px; border-radius: 20px; background: #cc0000e8; color: #fff; font-size: 10px; line-height: 1.7; max-width: calc(100% - 14px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.pickup-item p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 16px; line-height: 1.4; margin: 6px 2px 0; min-height: 67px; }
	.pickup-arrow { position: absolute; top: 41%; transform: translateY(-50%); border: 0; color: #fff; background: #0002; border-radius: 50%; width: 30px; height: 30px; font-size: 34px; line-height: 23px; cursor: pointer; opacity: 0; transition: opacity 150ms; }
	.pickup-window:hover .pickup-arrow, .pickup-window:focus-within .pickup-arrow { opacity: 1; }
	.pickup-arrow.previous { left: 4px; }
	.pickup-arrow.next { right: 4px; }
	.pickup-controls { position: relative; display: flex; justify-content: center; align-items: center; gap: 9px; margin-top: -3px; min-height: 17px; }
	.pickup-dots { display: flex; gap: 7px; }
	.pickup-dot { border: 0; padding: 0; width: 6px; height: 6px; border-radius: 50%; background: #d7d7d7; cursor: pointer; }
	.pickup-dot.active { background: var(--home-accent); }
	.pickup-playback { border: 0; padding: 0 3px; background: none; color: #777; font-size: 10px; line-height: 17px; cursor: pointer; }
	.home-shell { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 30px; max-width: 1200px; margin: 20px auto 65px; padding: 10px 30px 0; align-items: start; }
	.home-main { min-width: 0; max-width: none; padding: 0; margin: 0; }
	.home-intro { padding: 5px 25px 0; min-height: 96px; margin-bottom: 20px; }
	.home-intro h1 { font-size: 10px; font-weight: 400; line-height: 1.5; margin: 0 0 17px; }
	.home-intro p { font-size: 11px; line-height: 1.9; margin: 0; letter-spacing: 0.04em; }
	.home-sidebar { min-width: 0; }
	.widget-title { position: relative; font-size: 25px; line-height: 1.4; letter-spacing: 0.07em; font-weight: 400; padding: 0 0 10px; margin: 0 0 25px; }
	.widget-title::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; background: repeating-linear-gradient(135deg, #CC0000 0, #CC0000 2px, #fff 2px, #fff 4px); }
	.sponsor-guide .widget-title { margin: 0; }
	.sponsor-guide .home-products-cta { display: block; margin: 12px 0 22px; text-align: center; color: #8c8a84; font-size: 11px; text-underline-offset: 3px; }
	.profile-widget { border: 1px solid #eee; box-shadow: 0 0 2px #00000008; padding: 35px 25px 24px; margin: 0 0 34px; text-align: center; }
	.profile-avatar { display: inline-block; }
	.profile-avatar img { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; }
	.profile-widget h2 { font-size: 20px; font-weight: 500; margin: 8px 0 0; }
	.profile-subtitle { font-size: 12px; color: #aaa; margin: 0 0 18px; }
	.profile-copy { font-size: 16px; line-height: 1.65; text-align: left; }
	.profile-copy p { margin: 0 0 18px; }
	.profile-opening { line-height: 1.6; }
	.profile-copy ul { list-style: none; margin: 0 0 18px; padding: 0; }
	.profile-copy li::before { content: '✮ '; color: #CC0000; }
	.profile-button { display: block; width: 170px; border: 1px solid #CC0000; border-radius: 2px; margin: 18px auto 22px; padding: 7px; font-size: 14px; }
	.follow-label { margin: 0 0 5px; font-size: 12px; }
	.profile-social { display: flex; justify-content: center; align-items: center; gap: 18px; color: #CC0000; }
	.profile-social a { font-size: 23px; }
	.profile-social a:last-child { font-size: 12px; }
	.sidebar-banner { display: block; position: relative; padding: 25px 25px 26px; text-align: center; background: #CC0000; margin: 0 0 35px; border: 6px solid #fff1f1; outline: 1px solid #efcccc; box-shadow: 0 2px 5px #0001; }
	:global(.home-reference .sidebar-banner), :global(.home-reference .sidebar-banner:hover) { color: #fff; }
	.sidebar-banner > span:first-child { display: block; font-size: 17px; font-weight: 700; }
	.sidebar-banner small { font-size: 11px; }
	.sidebar-banner > span:last-child { position: absolute; right: 9px; top: 25%; font-size: 36px; }
	.sidebar-widget { margin: 0 0 40px; }
	.search-entry { display: flex; justify-content: space-between; gap: 5px; align-items: center; padding: 12px; border: 1px solid #ddd; color: #888; font-size: 12px; }
	.category-list, .recent-posts { padding: 0; list-style: none; margin: 0; }
	.category-list a { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 0; border-bottom: 1px solid #eee; font-size: 14px; }
	.category-count { color: #aaa; font-size: 11px; }
	.sidebar-tags { display: flex; gap: 7px 5px; flex-wrap: wrap; }
	.sidebar-tags a { background: #f4f4f4; border-radius: 2px; padding: 3px 7px; font-size: 11px; }
	.sidebar-tags a:hover { background: #fff1f1; }
	.all-tags { display: block; text-align: right; margin-top: 15px; font-size: 12px; }
	.recent-posts a { display: block; position: relative; font-size: 14px; padding: 12px 0 12px 14px; border-bottom: 1px solid #eee; line-height: 1.7; }
	.recent-posts a > span { position: absolute; left: 0; }
	.recent-posts time { display: block; font-size: 10px; color: #999; margin-top: 4px; text-align: right; }
	.category-features { margin: 55px 24px 0; }
	.category-feature { margin-bottom: 40px; }
	.category-feature h2 { font-weight: 400; font-size: 21px; padding-bottom: 10px; border-bottom: 3px solid var(--home-accent); margin-bottom: 25px; }
	.feature-banner { display: grid; position: relative; grid-template-columns: 40% 1fr; align-items: stretch; border: 6px solid #fff1f1; background: #fff1f1; border-radius: 2px; overflow: hidden; min-height: 150px; box-shadow: 0 1px 4px #0002; }
	.feature-banner img { width: 100%; height: 100%; min-height: 150px; object-fit: cover; border-radius: 0; }
	.feature-banner > span { align-self: center; padding: 15px 30px 15px 15px; text-align: center; font-size: 24px; font-weight: 700; }
	.feature-small { display: block; font-size: 12px; margin-top: 8px; font-weight: 400; }
	.feature-arrow { position: absolute; right: 12px; top: 30%; font-size: 36px; font-weight: 400; }
	.home-footer { background: #fff1f1; padding: 60px 30px 14px; }
	.footer-widgets { max-width: 1140px; display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 65px; margin: 0 auto 60px; font-size: 13px; }
	.footer-brand { display: block; font-size: 25px; font-weight: 700; letter-spacing: 0.02em; margin-bottom: 20px; }
	.footer-widgets h2 { font-size: 18px; border-bottom: 1px solid #ddb7b7; font-weight: 400; padding-bottom: 12px; margin-bottom: 20px; }
	.footer-widgets ul { list-style: none; padding: 0; margin: 0; }
	.footer-widgets li { margin: 8px 0; }
	.footer-about p { margin: 0 0 16px; }
	.footer-about p a { text-decoration: underline; }
	.home-copyright { text-align: center; font-size: 11px; margin: 0; }
	.back-to-top { position: fixed; bottom: 20px; right: 22px; width: 40px; height: 40px; background: #cc0000bf; border-radius: 50%; text-align: center; font-size: 29px; line-height: 43px; z-index: 20; }
	:global(.home-reference .back-to-top) { color: #fff; }
	@media (min-width: 768px) and (max-width: 1199px) {
		.pickup { margin-left: 30px; margin-right: 30px; }
		.home-shell { grid-template-columns: minmax(0, 1fr) 300px; gap: 25px; }
		.header-social { right: 25px; }
		.brand-title { font-size: 36px; }
		.profile-widget { padding: 30px 18px 20px; }
