---
import { getCollection } from 'astro:content';
import BlogArchive from '../../../../layouts/BlogArchive.astro';
import { ARCHIVE_CATEGORIES, ARCHIVE_PAGE_SIZE } from '../../../../utils/archivePagination.mjs';

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return ARCHIVE_CATEGORIES.flatMap((category) => {
		const categoryPosts = allPosts.filter((post) => post.data.category === category);
		const totalPages = Math.ceil(categoryPosts.length / ARCHIVE_PAGE_SIZE);
		return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
			const currentPage = index + 2;
			const start = (currentPage - 1) * ARCHIVE_PAGE_SIZE;
			return {
				params: { category, page: String(currentPage) },
				props: {
					category,
					posts: categoryPosts.slice(start, start + ARCHIVE_PAGE_SIZE),
					allPosts,
					currentPage,
				},
			};
		});
	});
}
---

<BlogArchive {...Astro.props} />
