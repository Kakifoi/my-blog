---
import { getCollection } from 'astro:content';
import BlogArchive from '../../layouts/BlogArchive.astro';
import LegacyCategory from '../../layouts/LegacyCategory.astro';
import { ARCHIVE_CATEGORIES, ARCHIVE_PAGE_SIZE } from '../../utils/archivePagination.mjs';

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	const categories = new Set(allPosts.map((post) => post.data.category));
	return [...categories].map((category) => {
		const categoryPosts = allPosts.filter((post) => post.data.category === category);
		return {
			params: { category },
			props: {
				category,
				posts: ARCHIVE_CATEGORIES.includes(category)
					? categoryPosts.slice(0, ARCHIVE_PAGE_SIZE)
					: categoryPosts,
				allPosts,
				currentPage: 1,
			},
		};
	});
}

const { category, posts } = Astro.props;
---

{ARCHIVE_CATEGORIES.includes(category)
	? <BlogArchive {...Astro.props} />
	: <LegacyCategory category={category} posts={posts} />}
