---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import HomeHeader from '../components/HomeHeader.astro';
import { SITE_TITLE } from '../consts';
import { tagSlug } from '../utils/tagSlug';

const pageTitle = 'カキフォイのプロフィール | ' + SITE_TITLE;
const pageDescription = '埼玉・熊谷で妻と2人の娘と暮らす、カキフォイの自己紹介。熊谷・深谷の食べ歩き、家族のおでかけ、買って使ったものを記録する「カキフォイの日記」について。';
const posts = await getCollection('blog');
const topics = [
	{
		slug: 'engawa-steak-french-toast',
		title: '熊谷・深谷の食べ歩き',
		description: '家族や妻と出かけたランチ、一人で食べに行ったラーメンなど。味や量の感想に、その日の出来事も添えて残しています。',
		image: '/images/engawa-steak-french-toast-6671.jpg',
		imageAlt: '黒い皿に盛られたフレンチトーストとアイス、ホイップクリーム',
		note: '夫婦で出かけた熊谷ランチ。ステーキ定食と、食後のフレンチトースト。',
		links: [
			{ label: 'グルメ', href: '/categories/グルメ/' },
			{ label: '熊谷', href: '/tags/' + tagSlug('熊谷') + '/' },
			{ label: '深谷', href: '/tags/' + tagSlug('深谷') + '/' },
		],
	},
	{
		slug: 'nasu-highland-park-family-trip',
		title: '家族のおでかけと日々のこと',
		description: '娘たちとの旅行や遊び場での一日、家でのちょっとした出来事。同じ場所でも違う、子どもたちそれぞれの楽しみ方を書いています。',
		image: '/images/nasu-highland-park-family-trip-E46F100C-7B83-482D-80F1-3D9D26A84C92.jpg',
		imageAlt: '高い場所から見た、緑に囲まれた那須ハイランドパークの遊具',
		note: '同じ遊園地でも、お気に入りはそれぞれ。家族4人の那須旅行です。',
		links: [
			{ label: '旅行・おでかけ', href: '/categories/旅行・おでかけ/' },
			{ label: '子育て・日常', href: '/categories/子育て・日常/' },
		],
	},
	{
		slug: 'nzxt-relay-speakers-review',
		title: '買って使ったもの、暮らしの工夫',
		description: 'ガジェットや家電を使って感じたこと、設定や買い替えで迷ったこと。自分の使い方や環境とあわせて紹介しています。',
		image: '/images/nzxt-relay-speakers-review-01-desk.jpg',
		imageAlt: 'PCモニターやキーボードと一緒に机に置いた黒いスピーカー',
		note: 'PCと実家のテレビで試したスピーカー。音の感想と、使い勝手を。',
		links: [
			{ label: 'ガジェット・テクノロジー', href: '/categories/ガジェット・テクノロジー/' },
		],
	},
].map((topic) => {
	const post = posts.find((entry) => entry.id === topic.slug);
	if (!post) throw new Error('Profile article not found: ' + topic.slug);
	return { ...topic, post };
});
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} ogImage={new URL('/images/profile-about.jpg', Astro.site).toString()} />
	</head>
	<body class="about-page">
		<a class="about-skip-link" href="#about-content">プロフィール本文へ移動</a>
		<HomeHeader />
		<main id="about-content" class="about-main">
			<section class="about-hero" aria-labelledby="profile-title">
				<div class="hero-introduction">
					<p class="section-label">プロフィール</p>
					<h1 id="profile-title">カキフォイ</h1>
				</div>
				<figure class="hero-portrait">
					<img src="/images/profile-about.jpg" alt="ミント色の背景に描かれた、ピースをするカキフォイの似顔絵" width="1024" height="1024" loading="eager" decoding="async" fetchpriority="high" />
				</figure>
				<div class="hero-bio">
					<p class="hero-lead">熊谷で、妻と2人の娘と暮らしています。</p>
					<p>熊谷・深谷で食べたごはんや、家族で出かけた日のことを日記にしています。ゲームやガジェットの話も、ときどき。</p>
					<p>味や量はどうだったか、子どもたちは何を楽しんでいたか。写真を見返しながら、その日に感じたことを書き残しています。</p>
				</div>
			</section>

			<section class="about-themes" aria-labelledby="themes-title">
				<div class="about-section-heading">
					<h2 id="themes-title">この日記で読めること</h2>
				</div>
				<div class="theme-grid">
					{topics.map((topic) => (
						<article class="theme">
							<div class="theme-introduction">
								<h3>{topic.title}</h3>
								<p>{topic.description}</p>
							</div>
							<a class="featured-story" href={'/blog/' + topic.post.id + '/'}>
								<img src={topic.image} alt={topic.imageAlt} width="1200" height="900" loading="lazy" decoding="async" />
								<span class="story-title">{topic.post.data.title}</span>
								<span class="story-note">{topic.note}</span>
							</a>
							<nav class="theme-links" aria-label={topic.title + 'の一覧'}>
								{topic.links.map((link) => <a href={link.href}>{link.label}</a>)}
							</nav>
						</article>
					))}
				</div>
			</section>

			<section class="about-section" aria-labelledby="life-title">
				<div class="about-section-heading">
					<h2 id="life-title">暮らしと日記</h2>
				</div>
				<div class="section-prose">
					<p>普段は物販の仕事をしています。趣味はゲームとジョギング。友人とナイトレインで遊んだり、PCやガジェットの使い勝手を考えたりする時間も好きです。</p>
					<p>日々の小さな出来事は、思ったより早く忘れてしまうもの。あとから読み返して、その日をもう一度楽しめるように、このブログを始めました。何でもない日の食事や、子どもたちのひと言も、大事な記録だと思っています。</p>
					<a class="text-link" href="/blog/why-i-started-blog/">ブログを始めた理由を読む<span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section class="about-section writing-section" aria-labelledby="writing-title">
				<div class="about-section-heading">
					<h2 id="writing-title">記事について</h2>
				</div>
				<div class="section-prose">
					<p>食べたものや使ったものは、自分の好みや使い方とあわせて感想を書いています。気に入ったところも、気になったところも、次に行く人・使う人の参考になればうれしいです。</p>
				</div>
			</section>

			<section class="about-connect" aria-labelledby="connect-title">
				<div class="about-section-heading">
					<h2 id="connect-title">SNS・お問い合わせ</h2>
					<p>写真や短い話はSNSにも載せています。ご連絡はお問い合わせフォームからどうぞ。</p>
				</div>
				<div class="connect-links">
					<a href="https://x.com/amekagari" target="_blank" rel="noopener noreferrer" aria-label="Xのプロフィール（新しいタブで開きます）">
						<span class="connect-name">X</span>
						<span class="connect-description">食べたものや、気になったことを気軽に。</span>
						<span class="connect-handle">@amekagari</span>
					</a>
					<a href="https://www.instagram.com/kakifoi_blog/" target="_blank" rel="noopener noreferrer" aria-label="Instagramのプロフィール（新しいタブで開きます）">
						<span class="connect-name">Instagram</span>
						<span class="connect-description">料理の写真を中心に、日記のひとこまを。</span>
						<span class="connect-handle">@kakifoi_blog</span>
					</a>
					<a href="/contact/">
						<span class="connect-name">お問い合わせ</span>
						<span class="connect-description">ブログの感想や、ご連絡はこちらから。</span>
						<span class="connect-handle">お問い合わせフォーム</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body.about-page) {
		--about-paper: #fffaf5;
		--about-ink: #3e302a;
		--about-muted: #75625a;
		--about-rule: #dfd2c7;
		--about-accent: #a52d2a;
		background: var(--about-paper);
		color: var(--about-ink);
		font-family: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
		font-size: 16px;
		line-height: 1.95;
	}
	:global(.about-page .home-header .navigation-inner a) { min-height: 44px; }
	.about-main { width: min(1100px, calc(100% - 64px)); max-width: none; margin: 0 auto; padding: 0 0 72px; }
	.about-main h1, .about-main h2, .about-main h3 { color: var(--about-ink); }
	.about-main h1, .about-main h2 { font-weight: 600; }
	.about-main p { margin: 0 0 1em; }
	.about-main a { color: var(--about-accent); }
	.about-main a:hover { color: #7d1f1d; }
	.about-main a:focus-visible, .about-skip-link:focus-visible { outline: 3px solid var(--about-accent); outline-offset: 5px; }
	.about-skip-link { position: fixed; z-index: 200; top: -80px; left: 12px; min-height: 44px; padding: 9px 16px; color: #7d1f1d; background: #fff; border: 1px solid #a52d2a; }
	.about-skip-link:focus { top: 12px; }
	.about-hero { display: grid; grid-template-columns: minmax(0, 1fr) 280px; grid-template-areas: 'intro portrait' 'bio portrait'; column-gap: 80px; row-gap: 24px; align-items: center; padding: 64px 0 60px; border-bottom: 1px solid var(--about-rule); }
	.hero-introduction { grid-area: intro; }
	.section-label { color: var(--about-accent); font-size: 13px; letter-spacing: 0.08em; }
	.about-main .section-label { margin-bottom: 14px; }
	.hero-introduction h1 { font-size: 32px; line-height: 1.5; letter-spacing: 0.02em; margin: 0; }
	.hero-portrait { grid-area: portrait; width: 280px; margin: 0; }
	.hero-portrait img { display: block; width: 100%; height: auto; border-radius: 3px; }
	.hero-bio { grid-area: bio; max-width: 41em; }
	.about-main .hero-lead { margin-bottom: 18px; font-size: 18px; line-height: 1.8; font-weight: 500; }
	.hero-bio p:last-child { margin-bottom: 0; }
	.about-themes { padding: 52px 0 56px; border-bottom: 1px solid var(--about-rule); }
	.about-section-heading h2 { font-size: 24px; line-height: 1.6; margin: 0 0 12px; }
	.about-section-heading > p { color: var(--about-muted); }
	.theme-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px; margin-top: 34px; }
	.theme { min-width: 0; display: flex; flex-direction: column; }
	.theme-introduction { min-height: 180px; }
	.theme-introduction h3 { min-height: 3.2em; margin: 0 0 12px; font-size: 20px; line-height: 1.6; font-weight: 600; }
	.theme-introduction p { font-size: 15px; line-height: 1.9; }
	.featured-story { display: block; text-decoration: none; }
	.featured-story img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; border-radius: 2px; background: #f0e9e2; }
	.story-title { display: block; margin-top: 16px; color: var(--about-ink); font-size: 16px; font-weight: 600; line-height: 1.8; text-decoration: underline; text-decoration-color: #c8b0a0; text-underline-offset: 5px; overflow-wrap: anywhere; }
	.featured-story:hover { text-decoration: none; }
	.featured-story:hover .story-title { color: var(--about-accent); text-decoration-color: currentColor; }
	.story-note { display: block; margin-top: 10px; color: var(--about-muted); font-size: 14px; line-height: 1.9; }
	.theme-links { display: flex; flex-wrap: wrap; gap: 0 18px; margin-top: auto; padding-top: 15px; }
	.theme-links a { display: inline-flex; min-height: 44px; align-items: center; padding: 6px 0; font-size: 14px; text-decoration: underline; text-decoration-color: #cfb8a8; text-underline-offset: 5px; overflow-wrap: anywhere; }
	.about-section { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 64px; padding: 52px 0; border-bottom: 1px solid var(--about-rule); }
	.section-prose { max-width: 44em; min-width: 0; }
	.section-prose p:last-child { margin-bottom: 0; }
	.text-link { display: inline-flex; align-items: center; gap: 20px; min-height: 44px; padding: 4px 0; text-decoration: underline; text-underline-offset: 5px; }
	.text-link span { font-size: 20px; text-decoration: none; }
	.about-connect { padding-top: 52px; }
	.connect-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 28px; }
	.connect-links a { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; min-height: 132px; padding: 20px 0 0; border-top: 1px solid var(--about-rule); color: var(--about-ink); text-decoration: none; }
	.connect-name { font-size: 20px; font-weight: 600; line-height: 1.5; }
	.connect-description { display: block; margin-top: 9px; font-size: 14px; line-height: 1.8; }
	.connect-handle { display: block; margin-top: 10px; color: var(--about-accent); font-size: 13px; text-decoration: underline; text-underline-offset: 4px; }
	.connect-links a:hover .connect-name { color: var(--about-accent); }
	@media (min-width: 768px) and (max-width: 1023px) {
		.about-hero { grid-template-columns: minmax(0, 1fr) 250px; column-gap: 40px; }
		.hero-portrait { width: 250px; }
		.hero-introduction h1 { font-size: 30px; }
		.theme-grid { gap: 25px; }
		.theme-introduction { min-height: 230px; }
		.theme-introduction h3 { font-size: 18px; }
		.about-section { grid-template-columns: 205px minmax(0, 1fr); gap: 36px; }
	}
	@media (max-width: 767px) {
		.about-main { width: min(560px, calc(100% - 40px)); padding-bottom: 48px; }
		.about-hero { grid-template-columns: 128px minmax(0, 1fr); grid-template-areas: 'portrait intro' 'bio bio'; gap: 26px 18px; align-items: center; padding: 32px 0 36px; }
		.hero-portrait { width: 128px; }
		.hero-introduction h1 { font-size: 24px; line-height: 1.6; letter-spacing: 0; }
		.about-main .section-label { margin-bottom: 8px; font-size: 11px; line-height: 1.7; letter-spacing: 0; }
		.about-main .hero-lead { margin-bottom: 18px; font-size: 17px; line-height: 1.85; }
		.about-themes, .about-section { padding: 36px 0; }
		.about-section-heading h2 { font-size: 21px; margin-bottom: 10px; }
		.about-section-heading > p { margin-bottom: 0; font-size: 15px; }
		.theme-grid { display: block; margin-top: 28px; }
		.theme + .theme { margin-top: 34px; padding-top: 30px; border-top: 1px solid var(--about-rule); }
		.theme-introduction { min-height: 0; }
		.theme-introduction h3 { min-height: 0; font-size: 20px; margin-bottom: 10px; }
		.theme-introduction p { margin-bottom: 18px; font-size: 16px; }
		.story-title { margin-top: 14px; font-size: 16px; }
		.theme-links { margin-top: 8px; padding-top: 0; }
		.about-section { display: block; }
		.about-section > .about-section-heading { margin-bottom: 20px; }
		.about-connect { padding-top: 36px; }
		.connect-links { display: block; margin-top: 22px; }
		.connect-links a { min-height: 128px; padding: 18px 0; }
	}
	@media (max-width: 359px) {
		.about-main { width: calc(100% - 32px); }
		.about-hero { grid-template-columns: 104px minmax(0, 1fr); column-gap: 16px; }
		.hero-portrait { width: 104px; }
		.hero-introduction h1 { font-size: 19px; }
	}
</style>
