---
import { getCollection } from 'astro:content';
import BlogArchive from '../../layouts/BlogArchive.astro';
import { ARCHIVE_PAGE_SIZE } from '../../utils/archivePagination.mjs';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BlogArchive
	posts={allPosts.slice(0, ARCHIVE_PAGE_SIZE)}
	allPosts={allPosts}
	currentPage={1}
/>
